# Copy this file to .env and fill in real values. .env is git-ignored.

# Where Postgres lives. Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://localhost:5432/yourmate_dev

# Used to sign login tokens. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

PORT=3000
